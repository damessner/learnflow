PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-secret

DB_DIALECT=better-sqlite3
DB_PATH=./data/learnflow.db

# PostgreSQL (production only)
# DB_DIALECT=pg
# DATABASE_URL=postgres://user:pass@localhost:5432/learnflow

# AI Providers (optional - configure one)
# GEMINI_API_KEY=your-key-here
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# OpenCode Server (optional - run `opencode serve` to start)
# OPENCODE_URL=http://127.0.0.1:4096
# OPENCODE_PROVIDER=deepseek
# OPENCODE_MODEL=deepseek-v4-flash

# Microsoft Teams Auth (optional)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT_ID=
